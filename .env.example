# PostgreSQL connection string. Never expose this with a NEXT_PUBLIC_ prefix.
DATABASE_URL=

# Public browser identifiers.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=1

# Server-only credentials. Never expose these with a NEXT_PUBLIC_ prefix.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
CLERK_SECRET_KEY=
CLERK_TELEMETRY_DISABLED=1
WEBHOOK_SECRET=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
